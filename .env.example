# Public site URL: set this after connecting your domain (used by sitemap and canonical URLs).
NEXT_PUBLIC_SITE_URL=

# Optional: enable the secure Supabase-powered catalogue and admin dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional tracking IDs; tracking stays disabled until these are configured.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Used only by scripts/seed-supabase.mjs on your local machine. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
